# Cronsole MCP server configuration.
#
# The server reads these from its PROCESS environment only — it does not load a
# .env file (copying this to .env.local does nothing). Export CRONSOLE_TOKEN in the
# environment you launch the MCP host from; .mcp.json references it as
# ${CRONSOLE_TOKEN} and never holds the literal secret.
#
#   Windows (persistent, then restart the host):
#     [Environment]::SetEnvironmentVariable('CRONSOLE_TOKEN', '<jwt>', 'User')
#   POSIX:
#     export CRONSOLE_TOKEN='<jwt>'
#
# Why this matters: if the variable is unset, Claude Code passes the *literal* text
# "${CRONSOLE_TOKEN}" through to the server, and the API rejects it as
# "403 Invalid or expired token" — which reads as an expired JWT and sends you
# debugging auth instead of your environment. configFromEnv() now detects that
# literal and refuses to start with an explicit message instead.

# Base URL of the Cronsole backend REST API (include the /api prefix).
# Local dev default:
CRONSOLE_API_URL=http://localhost:3000/api

# A user JWT the MCP server presents as the caller (Authorization: Bearer <token>).
# The server acts entirely as this one user — its tasks are the tasks it can see,
# run, and create. Mint one the same way the frontend dev token is minted:
#   node -e "console.log(require('jsonwebtoken').sign({id:'<userId>',email:'<email>'}, process.env.JWT_SECRET, {expiresIn:'30d'}))"
# (run from backend/ with the backend's JWT_SECRET in scope). Never commit a real token.
CRONSOLE_TOKEN=

# Optional: request timeout in milliseconds (default 15000).
# CRONSOLE_TIMEOUT_MS=15000

# Optional: expose the irreversible `delete_task` tool (default false).
#
# Deleting removes the REAL Task Scheduler entry via an ELEVATED agent, and there
# is no trash and no restore. An MCP host may call a tool with far less
# deliberation than a user clicking through the app's confirm dialog — and MCP has
# no equivalent of that dialog — so the verb is off unless you opt in here.
#
# Why an env var rather than a `confirm: true` tool parameter: the model fills a
# parameter in itself, so it is the caller assuring ITSELF that it is sure — the
# very deliberation that's missing. This is out of band: you set it, and no amount
# of agent reasoning reaches it.
#
# Only an exact "true" or "1" opens the gate; anything else (including an
# unexpanded "${CRONSOLE_MCP_ALLOW_DESTRUCTIVE}") fails CLOSED. When off, the tool
# is ABSENT from tools/list rather than present-and-refusing, so a model never
# plans around a capability it does not have.
#
# The reversible verbs (set_task_status, update_task_schedule, update_task_action)
# are NOT gated — prefer `set_task_status: DISABLED` to stop a task.
# CRONSOLE_MCP_ALLOW_DESTRUCTIVE=true
