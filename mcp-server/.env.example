# TaskHub MCP server configuration.
# Copy to .env.local (gitignored) or export these in the MCP host's env block.

# Base URL of the TaskHub backend REST API (include the /api prefix).
# Local dev default:
TASKHUB_API_URL=http://localhost:3000/api

# A user JWT the MCP server presents as the caller (Authorization: Bearer <token>).
# The server acts entirely as this one user — its tasks are the tasks it can see,
# run, and create. Mint one the same way the frontend dev token is minted:
#   node -e "console.log(require('jsonwebtoken').sign({id:'<userId>',email:'<email>'}, process.env.JWT_SECRET, {expiresIn:'30d'}))"
# (run from backend/ with the backend's JWT_SECRET in scope). Never commit a real token.
TASKHUB_TOKEN=

# Optional: request timeout in milliseconds (default 15000).
# TASKHUB_TIMEOUT_MS=15000
