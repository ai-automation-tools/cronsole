# Build config for the single-origin reverse-proxy deployment.
# Read by `npm run build:remote` (vite build --mode remote).
#
# `same-origin` tells the dashboard to resolve the API against window.location
# instead of a baked-in address, so ONE build is correct everywhere it is served:
# https://cronsole.example.com through the tunnel and http://localhost:8080 on the
# proxy locally. That is what removes the per-device "API origin" override.
#
# Do NOT set this for the normal local build — without the proxy in front, the API
# is on :3000 and the page is on :7373, so same-origin would point the dashboard at
# a port with no API on it. `npm run build` (no mode) keeps the localhost:3000
# default. Nothing secret goes in this file; VITE_* values are compiled into the
# bundle and served to every visitor.
VITE_API_URL=same-origin
