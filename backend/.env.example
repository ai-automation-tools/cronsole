# TaskHub backend configuration. Copy to `.env` and fill in real values.
# NEVER commit the filled-in `.env` (it's gitignored).

# Postgres connection string.
DATABASE_URL="postgresql://taskhub:password@localhost:5432/taskhub?schema=public"

# HTTP port the API/Socket.IO server listens on.
PORT=3000

# JWT signing secret for user auth. Must be strong (>= 16 chars); the backend
# refuses to start otherwise. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# AES-256-GCM key encrypting PlatformConnection.config at rest. Must be EXACTLY
# 32 characters; the backend refuses to start otherwise.
ENCRYPTION_KEY=""

# Shared pairing secret for the .NET agent's WebSocket handshake. The agent must
# set the same value as TASKHUB_PAIRING_SECRET. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_PAIRING_SECRET=""

# Optional. Set to "true" to disable the login/setup rate-limiter (per-IP, on
# /api/auth/login + /setup). It's already skipped under NODE_ENV=test; this is an
# escape hatch for local load testing. Leave unset in normal use.
# DISABLE_AUTH_RATE_LIMIT="true"

# Comma-separated browser origins allowed to open a Socket.IO connection. Needed
# for browser live updates (the /ui channel) — set to the frontend origin, e.g.
# http://localhost:7373 for local dev. Empty = no browser sockets (agent only).
ALLOWED_ORIGINS="http://localhost:7373"

# Optional server-side failure notifications. When URL is unset, failed runs are
# only recorded in ExecutionLog / dashboard state. Type can be: generic, discord,
# or ntfy. Extra headers are optional JSON, useful for bearer/API-key webhooks.
TASKHUB_FAILURE_WEBHOOK_URL=""
TASKHUB_FAILURE_WEBHOOK_TYPE="generic"
TASKHUB_FAILURE_WEBHOOK_HEADERS_JSON="{}"

# Optional base URL of the static template registry (index.json + templates/*.json).
# When set, the catalog is fetched from there — integrity-checked against each
# template's sha256, cached, and falling back to the compiled-in bundled snapshot
# on any failure. Lets the catalog update without shipping the app.
#
# DEFAULT: UNSET — the compiled-in bundled snapshot (backend/src/catalog/bundled.ts)
# is the source of truth, and `registry/` is generated from it. This defaulted to
# the hosted URL, which meant a local template edit was invisible until it had been
# published PUBLICLY — you had to ship a broken template to the world to test its
# fix. Local-first app, local-first dev loop.
#
# Set it to fetch a hosted catalog (and to exercise the real fetch + sha256 + cache
# path). The public registry — github.com/michaelschecht/taskhub-registry, served
# via GitHub Pages — is:
#TEMPLATE_REGISTRY_URL="https://mikesailab.com/taskhub-registry"

# How often the backend re-syncs the catalog from the registry into the DB, in
# ms (runtime refresh — no reseed needed). Defaults to 1800000 (30 min) when
# TEMPLATE_REGISTRY_URL is set, and is disabled for the bundled snapshot (it
# never changes at runtime). The backend always syncs once on boot regardless.
TEMPLATE_REGISTRY_SYNC_INTERVAL_MS=""
