        "script"
      ],
      "icon": "FileCode",
      "isStarter": true,
      "trigger": {
        "kind": "schedule",
        "cron": "0 8 * * *"
      },
      "commandTemplate": "python \"{{scriptPath}}\" {{args}}",
      "parameters": [
        {
          "key": "scriptPath",
          "label": "Script file path",
          "type": "path",
          "default": "",
