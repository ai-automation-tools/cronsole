{
  "name": "cronsole-mcp-server",
  "version": "0.9.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Model Context Protocol server for Cronsole — a thin wrapper over the REST API so Claude / Codex / Cursor can list, run, and create scheduled tasks via natural language.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cronsole-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cronsole",
    "scheduler"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "axios": "^1.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^25.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
