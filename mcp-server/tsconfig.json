{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": true
  },
  // Tests are excluded from the BUILD, not from typechecking: package.json ships
  // `files: ["dist"]`, so emitting src/__tests__ would publish the test suite (and
  // dangle a devDependency on vitest at runtime). `npm run typecheck` covers them
  // via tsconfig.test.json — vitest does not typecheck, so without that a type
  // error in a test would go unnoticed while the suite passed.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
