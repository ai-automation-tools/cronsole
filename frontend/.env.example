# Cronsole frontend configuration. Copy to `.env.local` and fill in.
# `.env.local` is gitignored — never commit real tokens.

# Default backend API origin. Defaults to http://localhost:3000 when unset.
# The running dashboard can override this per browser in Settings > About > API origin.
VITE_API_URL="http://localhost:3000"

# Optional dev/E2E fallback auth token. The dashboard now has a real login screen
# (single-user local login) and stores the login token per-browser; this is only
# used when no one has logged in — a convenience for local dev and the E2E suite.
# A real login token always wins. Leave empty to see the login/first-run screens.
# To skip login in dev, sign one with the backend's JWT_SECRET for the placeholder
# user (see backend/.env):
#   cd ../backend && node -r dotenv/config -e "console.log(require('jsonwebtoken').sign({id:'cli_user_placeholder',email:'mike@example.com'}, process.env.JWT_SECRET, {expiresIn:'3650d'}))"
VITE_DEV_TOKEN=""
