# --- Environment / secrets ---
.env
.env.*
!.env.example
# Vite build-mode config, NOT a secret store: `vite build --mode remote` reads it
# to set VITE_API_URL=same-origin for the single-origin proxy build. It is tracked
# because it is part of how the app is built, and it holds exactly one non-secret
# value. Keep it that way — anything confidential belongs in an ignored .env, and
# a VITE_* variable is compiled into the bundle and served to every visitor anyway.
!frontend/.env.remote
*.pem
*.key

# --- MCP host config (per-machine; may carry tokens/absolute paths) ---
# Which MCP servers your CLI loads is a local choice, not a repo fact. Commit the
# example instead: `cp .mcp.json.example .mcp.json` on a fresh clone.
.mcp.json

# --- Node / JS ---
node_modules/
dist/
build/
.vite/
.next/
.turbo/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- .NET (Windows agent) ---
bin/
obj/
*.user
*.suo
*.userprefs
*.pidb
*.cache
[Dd]ebug/
[Rr]elease/
[Bb]uildLog.*
.vs/
agent/publish/

# Agent config holds the pairing secret — keep it local (commit the example).
agent/Cronsole.Agent/appsettings.json
agent/Cronsole.Agent/appsettings.Local.json


# --- Installer artifacts ---
*.msi
*.msm
*.wixpdb
*.wixobj

# --- IDE / editor ---
.idea/
.vscode/
!.vscode/settings.json.example
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Prisma ---
prisma/migrations/dev.db*

# --- Logs ---
*.log
logs/

# --- Local DB files ---
*.sqlite
*.sqlite3
*.db
*.db-journal

# --- Gemini Agent ---

/Gemini_Agent/

# --- Local-only docs (historical plans, engineering specs, research) ---
docs/archive/

# --- Local-only docs: THIS machine's deployment ---
# Runbooks for the instance running on this specific machine — tailnet hostnames,
# device names, the exact ALLOWED_ORIGINS in force, which decisions were taken and
# why. Not secrets, but personal infrastructure identifiers that must not ride along
# into a repo headed for public release, and true of exactly one machine, so they
# would be wrong for anyone who cloned them.
#
# The generalizable half of this belongs in docs/user-guides/guides/, which IS
# tracked. If something written here would help a stranger, it is in the wrong file.
docs/local/

# --- .claude/: track ONLY commands, skills, and agents ---
# Deny by default, then re-include the three shared dirs. Everything else under
# .claude/ is per-machine noise (settings.local.json, temp/, images/, rules/, IDE
# state) and must never reach the repo. New junk added here is ignored by default
# rather than requiring someone to notice it.
/.claude/*
!/.claude/agents/
!/.claude/commands/
!/.claude/skills/

# --- Agent skill links (per-machine; created by scripts/setup-skill-links.ps1/.sh) ---
# The canonical skill lives at the repo-root skills/ (tracked). Claude Code reads
# it through a per-machine junction (Windows) / symlink (POSIX) at
# .claude/skills/<name>. The rest of .claude/skills/ IS tracked, so each link must
# be ignored by name: git follows a junction and would commit the skill content a
# second time (once under skills/, again under .claude/skills/).
# Add a line here for every new folder in skills/ -- the setup script warns if you forget.
# NOTE: must stay AFTER the !/.claude/skills/ re-include above -- last match wins.
/.claude/skills/cronsole/

# --- Local scratch / tooling artifacts ---
temp/
.playwright-mcp/

# --- Playwright E2E artifacts ---
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/
# --- Remote-access opt-in (per-machine; created by `cronsole remote on`) ---
# Presence of this file tells scripts/cronsole.ps1 to start the docker compose
# `proxy` service, which is what makes remote access survive a reboot or an
# explicit `docker compose stop`. Whether a machine publishes its dashboard is a
# property of THAT MACHINE, not of the checkout - committing it would silently
# opt every clone in, which is exactly the invariant the profile gate protects.
/.cronsole-remote
